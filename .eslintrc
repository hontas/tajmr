{
  "extends": ["airbnb", "prettier"],
  "plugins": ["cypress"],
  "parser": "@babel/eslint-parser",
  "env": {
    "browser": true,
    "jest": true,
    "cypress/globals": true
  },
  "rules": {
    "arrow-body-style": 1,
    "consistent-return": 1,
    "no-console": 2,
    "no-use-before-define": ["error", "nofunc"],
    "import/extensions": [2, "always", { "js": "never" }],
    "import/no-extraneous-dependencies": [
      "error",
      { "optionalDependencies": false, "peerDependencies": false }
    ],
    "object-curly-newline": 0,
    "import/prefer-default-export": 0,
    "import/no-unresolved": [2, { "commonjs": true, "caseSensitive": true, "ignore": ["^virtual:"] }],
    "react/button-has-type": 0,

    "react/destructuring-assignment": [2, "always", { "ignoreClassFields": true }],
    "react/require-default-props": 0,
    "react/no-typos": 0,
    "react/state-in-constructor": 0,
    "react/sort-comp": [
      2,
      {
        "order": ["static-methods", "lifecycle", "render", "everything-else"]
      }
    ],
    "react/jsx-props-no-spreading": 0,
    "jsx-a11y/label-has-associated-control": [
      2,
      {
        "labelComponents": ["Label"],
        "assert": "either"
      }
    ]
  },
  "overrides": [
    {
      // ESM-only packages with `exports` maps, which eslint-plugin-import 2.x can't resolve
      "files": ["vite.config.mjs", "pwa-assets.config.mjs"],
      "rules": { "import/no-unresolved": 0, "import/extensions": 0 }
    }
  ]
}
