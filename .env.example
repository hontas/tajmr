# Only needed for production builds that upload source maps to Sentry (npm run build).
# Copy to .env (gitignored). Local dev and tests need none of these.
# In CI: SENTRY_AUTH_TOKEN is an environment secret on "production";
# SENTRY_ORG and SENTRY_PROJECT are repository variables.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
