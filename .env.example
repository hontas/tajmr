# Not needed locally: local dev, tests and `npm run verify` use none of these.
# These are injected at build time by the "Build and Deploy" GitHub Actions workflow, which
# uploads source maps to Sentry (together with SENTRY_UPLOAD=true). Listed here for reference only:
#   SENTRY_AUTH_TOKEN  secret on the "production" environment
#   SENTRY_ORG         repository variable
#   SENTRY_PROJECT     repository variable
# Only copy this file to .env (gitignored) if you deliberately run a production build locally
# with source map upload.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
