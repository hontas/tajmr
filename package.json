{
  "name": "tajmr",
  "version": "0.0.0",
  "description": "Record time sometime",
  "scripts": {
    "format": "prettier --write \"client/**/*.{js,jsx,css}\" \"cypress/**/*.js\" \"test/*.js\" \"*.{js,mjs}\"",
    "format:check": "prettier --check \"client/**/*.{js,jsx,css}\" \"cypress/**/*.js\" \"test/*.js\" \"*.{js,mjs}\"",
    "knip": "knip",
    "lint": "eslint --ignore-path .gitignore --ext .js,.jsx,.mjs .",
    "test": "jest --notify",
    "test:timezones": "for tz in UTC America/New_York Asia/Kolkata; do TZ=$tz jest --ci || exit 1; done",
    "verify": "npm run lint && npm run format:check && npm run knip && jest --ci --coverage && npm run test:timezones && npm run build",
    "tdd": "npm run test -- --watch",
    "e2e": "npx cypress open",
    "build": "vp build",
    "dev": "vp dev",
    "preview": "vp preview"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged",
      "pre-push": "npm test && npx cypress run"
    }
  },
  "lint-staged": {
    "*.{js,jsx}": [
      "eslint --fix",
      "git add"
    ]
  },
  "author": "Pontus Lundin <lundin.pontus@gmail.com> (https://github.com/hontas)",
  "repository": {
    "type": "git",
    "url": "https://github.com/hontas/tajmr.git"
  },
  "license": "ISC",
  "browserslist": [
    "last 2 Chrome versions",
    "safari 14"
  ],
  "dependencies": {
    "@sentry/react": "^6.2.5",
    "@sentry/tracing": "^6.2.5",
    "classnames": "^2.2.6",
    "firebase": "^8.4.2",
    "prop-types": "^15.7.2",
    "react": "^17.0.1",
    "react-day-picker": "^7.3.2",
    "react-dom": "^17.0.1",
    "react-redux": "^7.2.2",
    "redux": "^4.0.4",
    "redux-thunk": "^2.3.0",
    "spinkit": "^2.0.1"
  },
  "devDependencies": {
    "@babel/core": "^7.6.2",
    "@babel/eslint-parser": "^7.13.14",
    "@babel/plugin-proposal-class-properties": "^7.5.5",
    "@babel/plugin-proposal-object-rest-spread": "^7.6.2",
    "@babel/plugin-syntax-dynamic-import": "^7.8.3",
    "@babel/preset-env": "^7.6.2",
    "@babel/preset-react": "^7.0.0",
    "@sentry/vite-plugin": "^5.4.1",
    "@sinonjs/fake-timers": "^6.0.1",
    "@testing-library/jest-dom": "^5.12.0",
    "@testing-library/react": "^11.2.6",
    "@vitejs/plugin-react": "^6.1.2",
    "cypress": "^6.6.0",
    "eslint": "^7.22.0",
    "eslint-config-airbnb": "^18.0.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-cypress": "^2.7.0",
    "eslint-plugin-import": "^2.18.2",
    "eslint-plugin-jsx-a11y": "^6.2.3",
    "eslint-plugin-react": "^7.16.0",
    "eslint-plugin-react-hooks": "^4.2.0",
    "husky": "^6.0.0",
    "jest": "^26.6.3",
    "knip": "^6.40.0",
    "lint-staged": "^10.5.4",
    "md5": "^2.2.1",
    "prettier": "^2.2.1",
    "vite-plugin-pwa": "^2.0.0",
    "vite-plus": "^1.1.0",
    "workbox-build": "^7.4.1"
  }
}
