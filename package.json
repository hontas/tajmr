{
  "name": "tajmr",
  "version": "0.0.0",
  "description": "Record time sometime",
  "scripts": {
    "format": "vp fmt \"src/**/*.{js,jsx,ts,tsx,css}\" \"cypress/**/*.js\" \"test/*.ts\" \"*.{js,mjs,md}\" \".github/**/*.md\"",
    "format:check": "vp fmt --check \"src/**/*.{js,jsx,ts,tsx,css}\" \"cypress/**/*.js\" \"test/*.ts\" \"*.{js,mjs,md}\" \".github/**/*.md\"",
    "knip": "knip",
    "lint": "vp lint",
    "test": "vp test run",
    "test:timezones": "for tz in UTC America/New_York Asia/Kolkata; do TZ=$tz vp test run || exit 1; done",
    "verify": "npm run lint && npm run format:check && npm run knip && vp test run --coverage && npm run test:timezones && npm run build",
    "tdd": "vp test watch",
    "e2e": "npx cypress open",
    "build": "vp build",
    "dev": "vp dev",
    "preview": "vp preview",
    "postbuild": "test -f dist/pwa-192x192.png -a -f dist/pwa-512x512.png -a -f dist/apple-touch-icon-180x180.png -a -f dist/favicon.ico || { echo 'PWA icons are missing from dist/ (see the icon plugin warnings above)'; exit 1; }",
    "prepare": "vp config"
  },
  "author": "Pontus Lundin <lundin.pontus@gmail.com> (https://github.com/hontas)",
  "repository": {
    "type": "git",
    "url": "https://github.com/hontas/tajmr.git"
  },
  "engines": {
    "node": ">=26"
  },
  "license": "ISC",
  "dependencies": {
    "@sentry/react": "^11.6.0",
    "@testing-library/dom": "^10.4.2",
    "classnames": "^2.2.6",
    "firebase": "^13.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "spinkit": "^2.0.1",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@rolldown/plugin-babel": "^0.2.4",
    "@sentry/vite-plugin": "^5.4.1",
    "@sinonjs/fake-timers": "^6.0.1",
    "@testing-library/jest-dom": "^5.12.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "cypress": "^6.6.0",
    "jsdom": "^29.1.1",
    "knip": "^6.40.0",
    "md5": "^2.2.1",
    "typescript": "^7.0.2",
    "vite-plugin-pwa": "^2.0.0",
    "vite-plus": "^1.1.0",
    "workbox-build": "^7.4.1"
  },
  "imports": {
    "#/*": "./src/*",
    "#test/*": "./test/*"
  }
}
